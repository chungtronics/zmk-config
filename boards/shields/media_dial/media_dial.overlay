/*
 * SPDX-License-Identifier: MIT
 *
 * Encoder SIQ-02FVS3 (3 chan: A - C - B) + 1 nut mute
 *
 * Day noi tren Pro Micro nRF52840 (build voi board nice_nano_v2):
 *   Encoder chan A  -> D2  (P0.17)
 *   Encoder chan C  -> GND   (chan giua, chan chung)
 *   Encoder chan B  -> D3  (P0.20)
 *   Nut mute        -> D4  (P0.22)  <-> GND
 *
 * Neu build cho board nrfmicro_13 thi van cam dung 3 chan D2/D3/D4
 * tren silk, chi khac GPIO ben trong (P0.15 / P0.17 / P0.20).
 */

/ {
    chosen {
        zmk,kscan = &kscan0;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;

        input-gpios = <&pro_micro 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };

    encoder: encoder {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder>;
        triggers-per-rotation = <20>;
    };
};
