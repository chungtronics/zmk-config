#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        // Nha ra nhanh -> mute. Giu du 5 giay -> mo khoa ZMK Studio.
        // Tham so thu nhat (0) khong duoc dung, vi studio_unlock khong nhan
        // tham so nao ca, nhung hold-tap van doi phai truyen du hai tham so.
        ht_studio: hold_tap_studio {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <5000>;
            bindings = <&studio_unlock>, <&kp>;
        };

        //   1 nhan  : mute / unmute   (giu 5 giay = mo khoa Studio)
        //   2 nhan  : play / pause
        //   3 nhan  : giu lai lan thu 3 roi xoay = chuyen bai
        td_media: tap_dance_media {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&ht_studio 0 C_MUTE>, <&kp C_PLAY_PAUSE>, <&mo 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        media_layer {
            display-name = "Media";
            bindings = <&td_media>;

            // Xoay phai: tang tieng -- Xoay trai: giam tieng
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        track_layer {
            display-name = "Track";
            bindings = <&trans>;

            // Nhan 3 lan, giu lan cuoi roi xoay: chuyen bai hat
            sensor-bindings = <&inc_dec_kp C_NEXT C_PREV>;
        };

        // Layer trong de danh cho ZMK Studio. Ban build thuong bo qua chung,
        // chi ban co Studio moi thay va cho phep dung toi.
        extra1 {
            status = "reserved";
        };

        extra2 {
            status = "reserved";
        };
    };
};
