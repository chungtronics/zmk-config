#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        // Nhan roi giu -> tam thoi sang track_layer (xoay = chuyen bai)
        lt_mute: layer_tap_mute {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        //   1 nhan  : mute / unmute   (giu lai = xoay chuyen bai)
        //   2 nhan  : play / pause
        td_media: tap_dance_media {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&lt_mute 1 C_MUTE>, <&kp C_PLAY_PAUSE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        media_layer {
            bindings = <&td_media>;

            // Xoay phai: tang tieng -- Xoay trai: giam tieng
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        track_layer {
            bindings = <&trans>;

            // Giu nut + xoay: chuyen bai hat
            sensor-bindings = <&inc_dec_kp C_NEXT C_PREV>;
        };
    };
};
